# One origin for the browser: the site, the API and the API docs. ${GATEWAY_URL} is filled in at start.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's DNS, re-resolved so a restarted gateway with a new IP is still found
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway ${GATEWAY_URL};

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/problem+json image/svg+xml;

    location /api/ {
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /v3/api-docs {
        proxy_pass $gateway;
        proxy_set_header Host $host;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed file names never change
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Client-side routes all serve the app; index.html is always revalidated so a deploy shows up at once
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri /index.html;
    }
}
