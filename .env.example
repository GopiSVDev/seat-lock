POSTGRES_DB=seatlock
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433
# API gateway: the only published app port (backend and payment listen inside Docker only)
GATEWAY_PORT=8080
BACKEND_PORT=8080
# Keycloak (identity provider): admin console at http://localhost:8180/admin (dev only credentials)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Backend token checks; realm, audience and client match keycloak/seatlock-realm.json.
# Keys are fetched over the Docker network; the issuer is the browser-facing URL (port = KEYCLOAK_PORT)
JWT_JWK_SET_URI=http://keycloak:8080/realms/seatlock/protocol/openid-connect/certs
JWT_ISSUER_URI=http://localhost:8180/realms/seatlock
JWT_AUDIENCE=seatlock-api
SWAGGER_OAUTH_CLIENT_ID=seatlock-web
# Payment service: own database and user in the same Postgres container
PAYMENT_PORT=8081
PAYMENT_DB=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=password
# Razorpay Test mode keys (dashboard > Account & Settings > API Keys); never commit real values
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Your own random value (openssl rand -hex 32); type the same into the Razorpay webhook form
RAZORPAY_WEBHOOK_SECRET=change-me
# Client credentials of each service in Keycloak (openssl rand -hex 32); read by Keycloak on realm import
BACKEND_CLIENT_SECRET=change-me
PAYMENT_CLIENT_SECRET=change-me
VM_IP=10.24.21.250
# Threads mostly wait on the payment service, not the CPU, so many are cheap; payment calls are capped
# separately. Queries take ~1 ms and checkout holds no connection, so 10 connections suffice.
# Re-tune with the load tests (the old 10 threads suited only the 1 vCPU VM).
DB_POOL_SIZE=10
TOMCAT_MAX_THREADS=200
# Checkout calls to the payment service at once (bulkhead); a quarter of the threads
PAYMENT_MAX_CONCURRENT_CALLS=50
