{
  "realm": "seatlock",
  "displayName": "SeatLock",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER"
      },
      {
        "name": "ADMIN"
      },
      {
        "name": "PAYMENTS_CLIENT"
      },
      {
        "name": "BOOKING_CALLBACK"
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-seatlock",
        "composite": true,
        "composites": {
          "realm": ["CUSTOMER", "offline_access", "uma_authorization"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-seatlock",
    "composite": true,
    "composites": {
      "realm": ["CUSTOMER", "offline_access", "uma_authorization"]
    }
  },
  "clients": [
    {
      "clientId": "seatlock-web",
      "name": "SeatLock web app and Swagger UI",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "seatlock-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "seatlock-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "seatlock-dev-cli",
      "name": "Dev only: tokens for curl, scripts and load tests",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "seatlock-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "seatlock-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "seatlock-backend",
      "name": "Backend service: calls the payment service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BACKEND_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "seatlock-payment-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "seatlock-payment-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "seatlock-payment",
      "name": "Payment service: tells the backend about payments",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PAYMENT_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "seatlock-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "seatlock-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-seatlock-backend",
      "enabled": true,
      "serviceAccountClientId": "seatlock-backend",
      "realmRoles": ["PAYMENTS_CLIENT"]
    },
    {
      "username": "service-account-seatlock-payment",
      "enabled": true,
      "serviceAccountClientId": "seatlock-payment",
      "realmRoles": ["BOOKING_CALLBACK"]
    },
    {
      "username": "admin",
      "email": "admin@seatlock.local",
      "firstName": "Site",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["default-roles-seatlock", "ADMIN"]
    },
    {
      "username": "asha",
      "email": "asha@seatlock.local",
      "firstName": "Asha",
      "lastName": "Kumar",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "asha", "temporary": false }
      ],
      "realmRoles": ["default-roles-seatlock"]
    },
    {
      "username": "ravi",
      "email": "ravi@seatlock.local",
      "firstName": "Ravi",
      "lastName": "Shankar",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "ravi", "temporary": false }
      ],
      "realmRoles": ["default-roles-seatlock"]
    }
  ]
}
